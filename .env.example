# Formspree form ID for the contact form.
# The current form ID is hardcoded in src/components/UI/Contact.jsx
# (https://formspree.io/f/mlgqqobj). Set this env var only if you swap forms.
# 1. For local dev: copy this file to .env.local and fill in the value.
# 2. For production: set the VITE_FORMSPREE_ID env var in Vercel (Settings -> Environment Variables).
# Only public values go here — never commit real secrets.
VITE_FORMSPREE_ID=
